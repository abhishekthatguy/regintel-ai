# RegIntel AI — local environment template. Copy to .env and fill in real values.
# NEVER commit a real .env. Placeholders only.

# Runtime
REGINTEL_ENV=local
REGINTEL_LOG_LEVEL=INFO
REGINTEL_DB_PATH=./data/regintel.db
REGINTEL_USECASE_DIR=./data/usecases
REGINTEL_DEFAULT_USECASE=it_support

# Demo identity (stub provider — replaced by Entra ID in Phase 3)
REGINTEL_DEFAULT_EMPLOYEE=e001

# API base URL used by the Streamlit UI
REGINTEL_API_BASE=http://localhost:8000

# --- Phase 3: auth / cloud switches ---
# REGINTEL_AUTH_MODE=stub|jwt
# REGINTEL_JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# REGINTEL_JWT_AUDIENCE=<entra-app-client-id-or-api-uri>
# REGINTEL_JWT_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# REGINTEL_JWT_SECRET=<dev-only-hs256-key>   # local JWT mode; never a real secret
# REGINTEL_STORE_BACKEND=sqlite|dynamodb
# REGINTEL_CACHE_BACKEND=local|redis
# REGINTEL_REDIS_URL=redis://<host>:6379/0
# REGINTEL_GUARDRAIL_ID=<bedrock-guardrail-id>:<version>

# LLM provider (Phase 1+). Leave unset in Phase 0 — stub agent is used.
# REGINTEL_LLM_PROVIDER=bedrock|openai|local
# REGINTEL_LLM_MODEL_ID=<model-id-from-config>
# AWS_REGION=<region>
# AWS_PROFILE=<profile>
# OPENAI_API_KEY=<key>
